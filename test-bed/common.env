#!/usr/bin/env bash
# Shared environment for test-bed scripts.
# Source this file, don't execute it.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Paths
BAO=${BAO_BIN:-"$PROJECT_ROOT/openbao/bin/bao"}
PLUGIN_SRC="$PROJECT_ROOT/openbao-plugin-secrets-gpg"
PLUGIN_NAME="openbao-plugin-secrets-gpg"
INSTANCE_DIR="$SCRIPT_DIR/openbao-instance"
PLUGIN_DIR="$INSTANCE_DIR/plugins"
LOG_DIR="$INSTANCE_DIR/logs"
DATA_DIR="$INSTANCE_DIR/data"
PIDFILE="$INSTANCE_DIR/server.pid"
INIT_FILE="$INSTANCE_DIR/init.json"

export BAO_ADDR=${BAO_ADDR:-http://127.0.0.1:8200}

# Ensure directories exist
mkdir -p "$PLUGIN_DIR" "$LOG_DIR" "$DATA_DIR"

build_plugin() {
    echo "Building plugin..."
    (cd "$PLUGIN_SRC" && go build -o "$PLUGIN_DIR/$PLUGIN_NAME" .) || {
        echo "ERROR: Plugin build failed." >&2
        return 1
    }
    echo "  -> $PLUGIN_DIR/$PLUGIN_NAME"
}

register_and_mount_plugin() {
    local sha
    sha=$(sha256sum "$PLUGIN_DIR/$PLUGIN_NAME" | awk '{print $1}')
    echo "Registering plugin (sha256=${sha:0:12}...)..."
    "$BAO" plugin register -sha256="$sha" secret "$PLUGIN_NAME"
    echo "Mounting at gpg/..."
    "$BAO" secrets enable -path=gpg -plugin-name="$PLUGIN_NAME" plugin
}

wait_for_server() {
    local max_wait=${1:-10}
    local i=0
    echo -n "Waiting for server"
    while [ $i -lt $max_wait ]; do
        if "$BAO" status >/dev/null 2>&1; then
            echo " ready."
            return 0
        fi
        echo -n "."
        sleep 1
        i=$((i + 1))
    done
    echo " TIMEOUT"
    return 1
}

stop_server() {
    if [ -f "$PIDFILE" ]; then
        local pid
        pid=$(cat "$PIDFILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "Stopping OpenBao (PID $pid)..."
            kill "$pid"
            # Wait for clean exit
            local i=0
            while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
                sleep 1
                i=$((i + 1))
            done
            if kill -0 "$pid" 2>/dev/null; then
                echo "  Force killing..."
                kill -9 "$pid" 2>/dev/null || true
            fi
            echo "  Stopped."
        else
            echo "PID $pid not running (stale pidfile)."
        fi
        rm -f "$PIDFILE"
    else
        # Try to find and kill any running bao server for this instance
        pkill -f "bao server.*$(basename "$INSTANCE_DIR")" 2>/dev/null && echo "Stopped orphan server." || echo "No server running."
    fi
}
